# CarSwap AI · параметры контура. Читает docker compose из deploy/.env
#
# Образец. Реальных значений здесь нет и быть не должно — файл в репозитории.
#
#   cp .env.example .env
#   chmod 600 .env
#
# deploy/.env закрыт .gitignore. Прежде чем коммитить что-либо в deploy/,
# убедитесь глазами, что заполненный .env туда не попал.
#
# Пароли генерировать, а не придумывать:
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# Три разных пароля, а не один на всех: у ролей разные права, и утечка
# пароля приложения не должна отдавать суперпользователя.

# ── база ────────────────────────────────────────────────────────────────

# Имя базы.
POSTGRES_DB=carswap

# Суперпользователь кластера. Нужен ровно для двух вещей: инициализации
# и посева (seed.sql пишет в таблицы с force RLS, а force RLS действует
# и на владельца схемы — обходит её только суперпользователь).
# Приложение под этой ролью не подключается никогда.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Владелец схемы. Под ним едут миграции. Не суперпользователь: RLS с force
# должна проверяться и на нём тоже.
CARSWAP_OWNER_PASSWORD=

# Роль подключения приложения. Входит в app_tenant, своих прав не имеет.
CARSWAP_APP_PASSWORD=

# ── приложение ──────────────────────────────────────────────────────────

# Тег образа. На сервере ставьте короткий хэш коммита, а не latest:
# по нему видно, какая версия крутится, и есть куда откатиться.
#   APP_TAG=$(git rev-parse --short HEAD)
APP_TAG=local

# Часовой пояс контура. Отчёты владельца считаются по границам суток.
TZ=Europe/Moscow

# ── каналы ──────────────────────────────────────────────────────────────
# Пробрасываются в контейнер приложения. Смысл каждой — app/.env.example.
# Пустые значения допустимы: без них не работает отправка, но контур
# поднимается и экраны открываются.
WAZZUP_API_KEY=
WAZZUP_CRM_KEY=
WEBHOOK_SECRET_WAZZUP=
WAZZUP_API_BASE=

# ── резервные копии ─────────────────────────────────────────────────────
# Каталог для копий. ВНЕ каталога проекта: в копиях лежат персональные
# данные, им нечего делать рядом с git. И на отдельном диске, а не на том
# же, где данные Postgres — иначе одна потерянная файловая система уносит
# и данные, и копии.
BACKUP_DIR=/var/backups/carswap

# Сколько дней держать копии на сервере.
BACKUP_KEEP_DAYS=14
