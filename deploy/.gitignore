# Заполненные параметры контура: пароли ролей базы и ключи каналов.
# В репозиторий не попадают никогда. Образец — .env.example.
.env
.env.*
!.env.example

# Сертификаты, если кто-то положит их рядом вместо тома.
*.pem
*.key

# Резервные копии. Их место — вне репозитория (backup.sh на это ругается),
# но правило пусть будет: в копиях персональные данные клиентов.
*.dump
*.tar.gz
backups/
